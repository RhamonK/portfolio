{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/secure-export.mjs",
    "start": "npx --yes serve@14.2.4 out",
    "lint": "tsc --noEmit",
    "test:security": "node --test scripts/secure-export.test.mjs",
    "art": "tsx --tsconfig scripts/tsconfig.json scripts/export-art.tsx",
    "core": "node scripts/render-core.mjs",
    "labo": "node scripts/render-lab.mjs",
    "check": "node scripts/check-palette.mjs && tsc --noEmit && npm run test:security && npm run build"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.169.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
